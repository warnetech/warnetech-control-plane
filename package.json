{
  "name": "warnet-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "d1:migrate:ghost": "wrangler d1 execute warnet-control-plane --file=schema/ghost_pointers.sql",
    "d1:migrate:cache": "wrangler d1 execute warnet-control-plane --file=schema/edge_signature_cache.sql",
    "d1:migrate": "npm run d1:migrate:ghost && npm run d1:migrate:cache"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.0"
  }
}
